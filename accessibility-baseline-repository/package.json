{
  "name": "accessibility-baseline-audit",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "audit": "npm run lighthouse",
    "lighthouse": "lighthouse https://doitc.rajasthan.gov.in/index.aspx --output html --output-path docs/lighthouse-report.html --only-categories=accessibility,performance,best-practices,seo"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2"
  }
}